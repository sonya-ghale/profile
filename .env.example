# GitHub personal access token (server-side only, never commit the real .env file)
# Create one at: https://github.com/settings/tokens
# Scopes needed: repo (or public_repo), read:user
#
# Local dev: put this in .env (used by `npm run dev`)
# Wrangler preview: copy to .dev.vars (used by `npm run preview`)
# Cloudflare Pages: add GITHUB_TOKEN as an encrypted variable in
# Workers & Pages > your project > Settings > Variables and Secrets
GITHUB_TOKEN=your_github_token_here
