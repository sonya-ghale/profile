# GitHub personal access token (server-side only, never commit the real .env file)
# Create one at: https://github.com/settings/tokens
# Scopes needed: repo (or public_repo), read:user
#
# Where to put GITHUB_TOKEN:
#
# npm run dev      → .env
# npm run preview  → .dev.vars  (wrangler does NOT read .env)
# Production       → wrangler secret put GITHUB_TOKEN  (Worker runtime secret)
GITHUB_TOKEN=your_github_token_here

# Contact form email (server-side only)
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=you@example.com
# For testing, Resend allows onboarding@resend.dev as the sender
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
