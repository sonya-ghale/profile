# GitHub personal access token (server-side only, never commit the real .env file)
# Create one at: https://github.com/settings/tokens
# Scopes needed: repo (or public_repo), read:user
#
# Where to put GITHUB_TOKEN:
#
# npm run dev      → .env
# npm run preview  → .dev.vars  (wrangler does NOT read .env)
# Cloudflare live  → Dashboard > Variables and Secrets (encrypted)
GITHUB_TOKEN=your_github_token_here
